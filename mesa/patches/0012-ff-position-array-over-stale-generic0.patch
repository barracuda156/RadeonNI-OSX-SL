diff --git a/src/mesa/main/varray.c b/src/mesa/main/varray.c
index 926a931..6b0814d 100644
--- a/src/mesa/main/varray.c
+++ b/src/mesa/main/varray.c
@@ -193,9 +193,16 @@ update_attribute_map_mode(const struct gl_context *ctx,
     */
    if (!_mesa_is_desktop_gl_compat(ctx))
       return;
-   /* The generic0 attribute superseeds the position attribute */
+   /* The generic0 attribute superseeds the position attribute, but not
+    * while the fixed-function pipeline draws and the vertex array is
+    * enabled too: programs (Sid Meier's Pirates! through its Direct3D
+    * layer) leave the generic arrays enabled after a vertex program and
+    * go on with glVertexPointer; only a vertex program reads them.
+    */
    const GLbitfield enabled = vao->Enabled;
-   if (enabled & VERT_BIT_GENERIC0)
+   if ((enabled & VERT_BIT_GENERIC0) &&
+       !((enabled & VERT_BIT_POS) &&
+         ctx->VertexProgram._VPMode == VP_MODE_FF))
       vao->_AttributeMapMode = ATTRIBUTE_MAP_MODE_GENERIC0;
    else if (enabled & VERT_BIT_POS)
       vao->_AttributeMapMode = ATTRIBUTE_MAP_MODE_POSITION;
@@ -203,6 +210,28 @@ update_attribute_map_mode(const struct gl_context *ctx,
       vao->_AttributeMapMode = ATTRIBUTE_MAP_MODE_IDENTITY;
 }
 
+/**
+ * The mapping depends on the vertex processing mode; redo it when that
+ * changes or another VAO is bound.
+ */
+void
+_mesa_refresh_vao_attribute_map(struct gl_context *ctx,
+                                struct gl_vertex_array_object *vao)
+{
+   gl_attribute_map_mode old;
+
+   if (!vao || vao->SharedAndImmutable || !_mesa_is_desktop_gl_compat(ctx))
+      return;
+   old = vao->_AttributeMapMode;
+   update_attribute_map_mode(ctx, vao);
+   if (vao->_AttributeMapMode != old) {
+      vao->_EnabledWithMapMode =
+         _mesa_vao_enable_to_vp_inputs(vao->_AttributeMapMode, vao->Enabled);
+      ST_SET_STATE(ctx->NewDriverState, ST_NEW_VERTEX_ARRAYS);
+      ctx->Array.NewVertexElements = true;
+   }
+}
