+/*
+ * The arrays the pipeline reads, from the ones the program enabled. As in
+ * the state tracker (st_atom_array.cpp, patch 0012):
+ *  - with a GLSL program, or an ARB vertex program whose text was not
+ *    scanned: all enabled arrays, and generic attribute 0 supersedes the
+ *    position array;
+ *  - with an ARB vertex program (scanned: the inputs it reads): only the
+ *    arrays it reads. Programs (Sid Meier's Pirates! through its Direct3D
+ *    layer) leave arrays enabled that point at memory they have freed, and
+ *    uploading those would read it;
+ *  - without a program the fixed-function pipeline reads only the
+ *    conventional arrays, so generic arrays left enabled are ignored and the
+ *    position array wins. Without the position array enabled, generic 0
+ *    stands for it.
+ */
+static bool
+glthread_ff_mode(struct gl_context *ctx)
+{
+   return ctx->API == API_OPENGL_COMPAT &&
+          !ctx->GLThread.VertexProgramArb &&
+          ctx->GLThread.CurrentProgram == 0;
+}
+
+/* The inputs of the bound ARB vertex program, or 0 when not known. The
+ * table is the share group's: programs are shared between contexts. */
+static GLbitfield
+glthread_vp_inputs(struct gl_context *ctx)
+{
+   struct glthread_state *g = &ctx->GLThread;
+   struct gl_shared_state *sh = ctx->Shared;
+
+   if (ctx->API != API_OPENGL_COMPAT || !g->VertexProgramArb ||
+       g->CurrentProgram != 0 || g->VertexProgramBound == 0 ||
+       g->VertexProgramBound >= GLTHREAD_VP_TRACKED || !sh ||
+       !p_atomic_read(&sh->GLThreadVPKnown[g->VertexProgramBound]))
+      return 0;
+   return sh->GLThreadVPInputs[g->VertexProgramBound];
+}
+
+static void
+glthread_vp_set(struct gl_context *ctx, GLuint id, GLbitfield inputs, int known)
+{
+   struct gl_shared_state *sh = ctx->Shared;
+
+   if (!sh || id == 0 || id >= GLTHREAD_VP_TRACKED)
+      return;
+   sh->GLThreadVPInputs[id] = inputs;
+   p_atomic_cmpxchg(&sh->GLThreadVPKnown[id],
+                    p_atomic_read(&sh->GLThreadVPKnown[id]), known);
+}
+
+static void
+resolve_vao(struct gl_context *ctx, struct glthread_vao *vao)
+{
+   const bool ff = glthread_ff_mode(ctx);
+   const GLbitfield user = vao->UserEnabled;
+   const GLbitfield inputs = ff ? 0 : glthread_vp_inputs(ctx);
+   GLbitfield enabled;
+
+   if (ff) {
+      enabled = user & VERT_BIT_FF_ALL;
+      if (!(user & VERT_BIT_POS) && (user & VERT_BIT_GENERIC0))
+         enabled |= VERT_BIT_GENERIC0;
+   } else {
+      enabled = user;
+      if (enabled & VERT_BIT_GENERIC0)
+         enabled &= ~VERT_BIT_POS;
+      if (inputs) {
+         /* The position slot is read through POS or generic 0. */
+         GLbitfield keep = inputs & ~(VERT_BIT_POS | VERT_BIT_GENERIC0);
+
+         if (inputs & (VERT_BIT_POS | VERT_BIT_GENERIC0))
+            keep |= VERT_BIT_POS | VERT_BIT_GENERIC0;
+         enabled &= keep;
+      }
+   }
+
+   for (unsigned i = 0; i < ARRAY_SIZE(vao->Attrib); i++)
+      vao->Attrib[i].EnabledAttribCount = 0;
+   vao->BufferEnabled = 0;
+   vao->BufferInterleaved = 0;
+   vao->Enabled = enabled;
+
+   while (enabled) {
+      const unsigned a = u_bit_scan(&enabled);
+
+      enable_buffer(vao, vao->Attrib[a].BufferIndex);
+   }
+   vao->ProgramGenResolved = ctx->GLThread.ProgramGen;
+}
+
+/* What the VAOs resolve to may have changed: redo the current one. */
+static void
+program_state_changed(struct gl_context *ctx)
+{
+   struct glthread_vao *vao = ctx->GLThread.CurrentVAO;
+
+   ctx->GLThread.ProgramGen++;
+   if (vao)
+      resolve_vao(ctx, vao);
+}
+
+void
+_mesa_glthread_update_vao_mode(struct gl_context *ctx)
+{
+   program_state_changed(ctx);
+}
+
+/*
+ * A log of the array state at draws, for programs that crash glthread
+ * (journal 2026-10-11): while /tmp/rdngld.arrays exists, one line in
+ * /tmp/rdn-arrays.log for every new combination of what the draw reads.
+ */
+void
+_mesa_glthread_debug_draw(struct gl_context *ctx, const char *what)
+{
+   static int on = -1;
+   static uint64_t seen[512];
+   static unsigned nseen;
+   struct glthread_state *g = &ctx->GLThread;
+   struct glthread_vao *vao = g->CurrentVAO;
+   struct gl_shared_state *sh = ctx->Shared;
+   const GLuint b = g->VertexProgramBound;
+   const int known = b < GLTHREAD_VP_TRACKED ? sh->GLThreadVPKnown[b] : -1;
+
+   if (on < 0)
+      on = access("/tmp/rdngld.arrays", F_OK) == 0;
+   if (!on)
+      return;
+
+   uint64_t key = ((uint64_t)vao->UserEnabled * 0x9E3779B97F4A7C15ull) ^
+                  ((uint64_t)vao->Enabled << 21) ^ ((uint64_t)b << 7) ^
+                  ((uint64_t)g->CurrentProgram << 40) ^
+                  ((uint64_t)g->VertexProgramArb << 3) ^
+                  ((uint64_t)vao->UserPointerMask << 11) ^
+                  ((uint64_t)(known + 1) << 5);
+   for (unsigned i = 0; i < nseen; i++)
+      if (seen[i] == key)
+         return;
+   if (nseen < 512)
+      seen[nseen++] = key;
+
+   FILE *f = fopen("/tmp/rdn-arrays.log", "a");
+   if (!f)
+      return;
+   fprintf(f, "%s: ctx %p user 0x%x enabled 0x%x userptr 0x%x arbvp %d "
+           "bound %u known %d inputs 0x%x glsl %u ff %d\n", what, (void *)ctx,
+           (unsigned)vao->UserEnabled, (unsigned)vao->Enabled,
+           (unsigned)vao->UserPointerMask, g->VertexProgramArb, b, known,
+           known > 0 ? (unsigned)sh->GLThreadVPInputs[b] : 0,
+           g->CurrentProgram, glthread_ff_mode(ctx));
+   for (unsigned a = 0; a < VERT_ATTRIB_MAX; a++)
+      if (vao->UserEnabled & (1u << a))
+         fprintf(f, "   attrib %u: buffer %u ptr %p stride %d\n", a,
+                 vao->Attrib[a].BufferIndex, vao->Attrib[a].Pointer,
+                 vao->Attrib[a].Stride);
+   fclose(f);
+}
+
+void
+_mesa_glthread_bind_vertex_program(struct gl_context *ctx, GLuint id)
+{
+   ctx->GLThread.VertexProgramBound = id;
+   program_state_changed(ctx);
+}
+
+/* The vertex attributes the text of an ARB vertex program reads. */
+static bool
+scan_vertex_program(const char *t, size_t len, GLbitfield *out)
+{
+   GLbitfield in = 0;
+   bool ok = true;
+
+   for (size_t i = 0; i + 8 < len; i++) {
+      const char *p = t + i;
+      unsigned lo, hi;
+
+      if (i > 0 && (isalnum((unsigned char)p[-1]) || p[-1] == '_'))
+         continue;
+      if (!strncmp(p, "OPTION", 6) && strstr(p, "ARB_position_invariant") &&
+          (size_t)(strstr(p, "ARB_position_invariant") - p) < 40)
+         in |= VERT_BIT_POS;
+      if (strncmp(p, "vertex.", 7))
+         continue;
+      p += 7;
+      if (!strncmp(p, "position", 8)) {
+         in |= VERT_BIT_POS;
+      } else if (!strncmp(p, "normal", 6)) {
+         in |= VERT_BIT_NORMAL;
+      } else if (!strncmp(p, "color", 5)) {
+         in |= !strncmp(p + 5, ".secondary", 10) ? VERT_BIT_COLOR1 :
+                                                  VERT_BIT_COLOR0;
+      } else if (!strncmp(p, "fogcoord", 8)) {
+         in |= VERT_BIT_FOG;
+      } else if (!strncmp(p, "pointsize", 9)) {
+         in |= VERT_BIT_POINT_SIZE;
+      } else if (!strncmp(p, "texcoord", 8)) {
+         if (p[8] == '[') {
+            if (sscanf(p + 9, "%u..%u", &lo, &hi) != 2) {
+               if (sscanf(p + 9, "%u", &lo) != 1) {
+                  ok = false;
+                  continue;
+               }
+               hi = lo;
+            }
+            for (; lo <= hi && lo < 8; lo++)
+               in |= VERT_BIT_TEX(lo);
+         } else {
+            in |= VERT_BIT_TEX(0);
+         }
+      } else if (!strncmp(p, "attrib[", 7)) {
+         if (sscanf(p + 7, "%u..%u", &lo, &hi) != 2) {
+            if (sscanf(p + 7, "%u", &lo) != 1) {
+               ok = false;
+               continue;
+            }
+            hi = lo;
+         }
+         for (; lo <= hi && lo < 16; lo++)
+            in |= VERT_BIT_GENERIC(lo);
+      } else {
+         /* weight, matrixindex, ...: not mapped here; read everything. */
+         ok = false;
+      }
+   }
+   *out = in;
+   return ok;
+}
+
+/* Also called from the program's own entry point (arbprogram.c), which runs
+ * whether or not glthread was already on for the call. */
+void
+_mesa_glthread_scan_vertex_program(struct gl_context *ctx, GLuint id,
+                                   const GLvoid *text, GLsizei len)
+{
+   GLbitfield inputs = 0;
+   bool known = text && len > 0 &&
+                scan_vertex_program(text, len, &inputs) && inputs;
+
+   if (access("/tmp/rdngld.arrays", F_OK) == 0) {
+      FILE *f = fopen("/tmp/rdn-arrays.log", "a");
+
+      if (f) {
+         fprintf(f, "ProgramStringARB(vertex) ctx %p id %u len %d known %d "
+                 "inputs 0x%x\n", (void *)ctx, id, (int)len, (int)known,
+                 (unsigned)inputs);
+         fclose(f);
+      }
+   }
+   glthread_vp_set(ctx, id, known ? inputs : 0, known);
+}
+
+void
+_mesa_glthread_vertex_program_string(struct gl_context *ctx,
+                                     const GLvoid *text, GLsizei len)
+{
+   _mesa_glthread_scan_vertex_program(ctx, ctx->GLThread.VertexProgramBound,
+                                      text, len);
+   program_state_changed(ctx);
+}
+
+void
+_mesa_glthread_delete_vertex_programs(struct gl_context *ctx, GLsizei n,
+                                      const GLuint *ids)
+{
+   struct glthread_state *g = &ctx->GLThread;
+
+   for (GLsizei i = 0; ids && i < n; i++) {
+      glthread_vp_set(ctx, ids[i], 0, 0);
+      if (ids[i] == g->VertexProgramBound)
+         g->VertexProgramBound = 0;
+   }
+   program_state_changed(ctx);
+}
